# Copy this file to `.env` and fill in real values. Never commit `.env`.

# ---- Public.com API (live trading + historical bars) -----------------------
# Required for both the live bot AND the new public_bars.py historical layer.
PUBLIC_SECRET=your_public_api_secret

# ---- Supabase (logs, trades, positions) ------------------------------------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your_service_role_key

# ---- Notifications ---------------------------------------------------------
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your/webhook

# ---- Live bot historical data provider (current path) ----------------------
# market_data.py uses Polygon for the live bot. Free tier: 5 calls/minute.
POLYGON_API_KEY=your_polygon_api_key

# ---- Optional: Alpha Vantage (legacy / fallback) ---------------------------
ALPHA_VANTAGE_API_KEY=

# ---- Bot mode + universe ---------------------------------------------------
MODE=live
SYMBOLS=QQQ,SCHB,SCHD,SGOV,SPY,VTI
SCAN_SYMBOLS=AAPL,MSFT,NVDA,AMZN,GOOGL,META,TSLA
MOMENTUM_SYMBOLS=AAPL,MSFT,NVDA,AMZN,GOOGL,META,TSLA,QQQ,SPY
MOMENTUM_TOP_N=3
MOMENTUM_SELL_RANK=5

# ---- Risk + exposure -------------------------------------------------------
MAX_TRADES_PER_DAY=10
MAX_ORDER_AMOUNT_USD=10
MAX_OPEN_POSITIONS=5
MAX_DRAWDOWN=0.08
DAILY_LOSS_LIMIT=0.03
LOSS_COOLDOWN_DAYS=3
MAX_EXPOSURE_EARLY=0.90
MAX_EXPOSURE_MID=0.75
MAX_EXPOSURE_LATE=0.50
WITHDRAW_DATE=2026-05-10
LOCKDOWN_DAYS=14

# ---- Strategy parameters ---------------------------------------------------
ATR_PERIOD=14
ATR_VOL_THRESHOLD=0.01
TREND_FAST=5
TREND_SLOW=20
TREND_STRONG_THRESHOLD=0.5
TAKE_PROFIT_BASE=0.04
STOP_LOSS_BASE=0.02
BASE_POSITION_SIZE=0.10
MAX_POSITION_SCALE=2.0
REGIME_SYMBOL=SPY
REGIME_FAST=50
REGIME_SLOW=200
CONFIDENCE_MIN_THRESHOLD=0.3
MANAGE_ALL_POSITIONS=true

# ---- New (public_bars.py / backtest_public.py) -----------------------------
# No new env vars required. PUBLIC_SECRET above is reused.
# Optional override knobs you can add later if you migrate live signals:
# PUBLIC_BARS_PERIOD=YEAR
# PUBLIC_BARS_INCLUDE_PRE_MARKET=false
# PUBLIC_BARS_INCLUDE_AFTER_MARKET=false
